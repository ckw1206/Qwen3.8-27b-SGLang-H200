# Optional per-run overrides for start.sh.
#
# cp .env.sample .env   (the real .env is not tracked by git).
# Precedence: shell env > ./.env > start.sh defaults.

# GPUs to use: 2 -> TP2 (default), 1 -> single GPU. Other counts are rejected.
GPU_ID=0,1
# GPU_ID=0

# API bind address and port.
HOST=0.0.0.0
PORT=8000

# Checkpoint: Qwen/Qwen3.8-27B (BF16, default) or Qwen/Qwen3.8-27B-FP8.
# MODEL_ID=Qwen/Qwen3.8-27B-FP8

# SGLang image.
IMAGE=lmsysorg/sglang:v0.5.21

# Fraction of GPU memory for weights + KV cache + GDN state (cookbook value).
MEM_FRACTION=0.85

# Speculative decoding with the in-checkpoint MTP head (0 = off, 1 = on).
MTP=0

# HuggingFace cache on the host (~55GB for BF16).
# HF_CACHE=/data/huggingface

# Optional; Qwen3.8-27B is public, a token only raises Hub rate limits.
# HF_TOKEN=

# Extra SGLang flags, appended last (override anything above).
# EXTRA_ARGS=--context-length 131072
